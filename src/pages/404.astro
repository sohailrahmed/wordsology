---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap" style="max-width:720px;padding-top:72px">
    <p class="eyebrow">404</p>
    <h1 style="font-size:44px;margin:0 0 16px;font-weight:800">That page moved or doesn't exist.</h1>
    <p style="font-size:18px;color:var(--ink-2);margin:0 0 28px">The site was rebuilt in 2026. Everything is still here, just organized better.</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px">
      <a class="btn btn-primary" href="/">Go home</a>
      <a class="btn btn-secondary" href="/high-yield-notes-2/">Browse subjects</a>
      <a class="btn btn-secondary" href="/search/">Search</a>
    </div>
  </section>
</Base>
