---
// Mini Exam Simulator: exam-style mini-tests of 5 random questions, one at a time, no going back,
// a countdown timer, and results with explanations at the end. Scores are remembered on the visitor's device.
// Questions live in src/data/practice-questions.json (`answer` is 0 for A, 1 for B…).
import Base from '../layouts/Base.astro';
import { subjects } from '../data/subjects';
import questions from '../data/practice-questions.json';

const topicInfo: Record<string, { name: string; color: string; tint: string }> = {
  ...Object.fromEntries(subjects.map((s) => [s.id, { name: s.name, color: s.color, tint: s.tint }])),
  'lab-ops': { name: 'Lab operations & statistics', color: '#4A5A50', tint: '#EEF0EC' },
};
const L = 'ABCDE';
const paras = (s: string) => s.split(/\n\n+/);
const data = JSON.stringify({ questions, topics: topicInfo });
---
<Base title="Mini Exam Simulator" description="Free ASCP-style mini-tests: 5 random questions at a time, one question per screen, timed like the real exam, with full explanations at the end.">
  <header class="pq-head">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / Mini Exam Simulator</p>
      <h1>Mini Exam Simulator</h1>
      <p class="lede">Five questions at a time, just like exam day: one question per screen, no going back, and the clock is running. You'll see your score and every explanation at the end.</p>
    </div>
  </header>

  <main class="wrap pq-main">
    <!-- start screen -->
    <section class="pq-card" id="pq-start" hidden>
      <h2>Start a mini-test</h2>
      <ul class="pq-rules">
        <li><b>5 questions</b> · <b>7½ minutes</b> (about the pace of the real exam)</li>
        <li>One question at a time. Once you press Next, you can't go back.</li>
        <li>No answers until the end, then you get your score and every explanation.</li>
      </ul>
      <button type="button" class="btn btn-primary pq-go" id="pq-begin">Start test</button>
      <p class="pq-seen" id="pq-seen"></p>
      <div class="pq-history" id="pq-history" hidden>
        <h3>Your recent tests</h3>
        <ol id="pq-hist-list"></ol>
        <p class="pq-best" id="pq-best"></p>
      </div>
    </section>

    <!-- the test -->
    <section class="pq-card pq-test" id="pq-test" hidden>
      <div class="pq-bar">
        <span class="pq-count" id="pq-count">Question 1 of 5</span>
        <span class="pq-timer" id="pq-timer" aria-live="off">7:30</span>
      </div>
      <div class="pq-progress"><span id="pq-progress"></span></div>
      <div class="pq-q" id="pq-q"></div>
      <ol class="pq-choices" id="pq-choices"></ol>
      <div class="pq-actions"><button type="button" class="btn btn-primary" id="pq-next" disabled>Next</button></div>
    </section>

    <!-- results -->
    <section id="pq-results" hidden>
      <div class="pq-card pq-score">
        <p class="pq-big" id="pq-big"></p>
        <p class="pq-sub" id="pq-sub"></p>
        <div class="pq-actions">
          <button type="button" class="btn btn-primary" id="pq-again">Take another 5</button>
          <button type="button" class="btn btn-secondary" id="pq-home">See my scores</button>
        </div>
      </div>
      <h2 class="pq-review-h">Review your answers</h2>
      <div id="pq-review"></div>
    </section>

    <!-- without JavaScript (and for search engines), every question is listed here -->
    <noscript>
      {questions.map((q, n) => (
        <article class="pq-card">
          <p><b>Question {n + 1}</b> · {topicInfo[q.topic].name}</p>
          {paras(q.q).map((p) => <p>{p}</p>)}
          <ol type="A">{q.choices.map((c) => <li>{c}</li>)}</ol>
          <details><summary>Answer and explanation</summary>{paras(q.explain).map((p) => <p>{p}</p>)}</details>
        </article>
      ))}
    </noscript>
  </main>
  <script type="application/json" id="pq-data" set:html={data}></script>
</Base>

<script>
  type Q = { id: string; topic: string; q: string; choices: string[]; answer: number; explain: string; link: string };
  const { questions, topics } = JSON.parse(document.getElementById('pq-data')!.textContent!) as { questions: Q[]; topics: Record<string, { name: string; color: string; tint: string }> };
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const L = 'ABCDE';
  const N = 5, SECONDS_PER_Q = 90;
  const KEY = 'wsPractice';

  // ---- remembered on this device only ----
  type Store = { seen: string[]; history: { d: string; right: number; n: number; topic: string; secs: number }[] };
  function load(): Store {
    try { const s = JSON.parse(localStorage.getItem(KEY) || 'null'); if (s && Array.isArray(s.seen)) return s; } catch (e) { /* storage blocked */ }
    return { seen: [], history: [] };
  }
  function save(s: Store) { try { localStorage.setItem(KEY, JSON.stringify(s)); } catch (e) { /* storage blocked */ } }
  let store = load();

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const paras = (s: string) => s.split(/\n\n+/).map((p) => `<p>${esc(p)}</p>`).join('');
  const shuffle = <T,>(a: T[]) => { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
  const show = (id: string) => ['pq-start', 'pq-test', 'pq-results'].forEach((x) => { $(x).hidden = x !== id; });
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

  // ---- start screen ----
  function renderStart() {
    const pool = questions;
    const seen = pool.filter((q) => store.seen.includes(q.id)).length;
    $('pq-seen').textContent = seen >= pool.length ? `You've seen all ${pool.length} questions. Your next test starts a fresh round.` : seen ? `You've seen ${seen} of ${pool.length} questions. New ones come first.` : `${pool.length} questions from every subject, drawn at random.`;
    const h = store.history.slice(-5).reverse();
    $('pq-history').hidden = !h.length;
    $('pq-hist-list').innerHTML = h.map((x) => `<li><b>${x.right} / ${x.n}</b> <span>${Math.round((100 * x.right) / x.n)}% · ${new Date(x.d).toLocaleDateString()}</span></li>`).join('');
    const best = store.history.reduce((b, x) => Math.max(b, x.right / x.n), 0);
    $('pq-best').textContent = store.history.length ? `Best: ${Math.round(best * 100)}% · Tests taken: ${store.history.length}` : '';
    show('pq-start');
  }

  // ---- the test ----
  let test: Q[] = [], picks: (number | null)[] = [], at = 0, topic = 'all', secsLeft = 0, total = 0, tick = 0;
  function begin() {
    const pool = questions;
    const fresh = shuffle(pool.filter((q) => !store.seen.includes(q.id)));
    const old = shuffle(pool.filter((q) => store.seen.includes(q.id)));
    test = [...fresh, ...old].slice(0, Math.min(N, pool.length));
    if (!fresh.length) { store.seen = store.seen.filter((id) => !pool.some((q) => q.id === id)); } // seen them all: start a new round
    picks = test.map(() => null); at = 0;
    total = secsLeft = test.length * SECONDS_PER_Q;
    clearInterval(tick);
    tick = window.setInterval(() => {
      secsLeft--; $('pq-timer').textContent = fmt(Math.max(0, secsLeft));
      $('pq-timer').classList.toggle('low', secsLeft <= 60);
      if (secsLeft <= 0) finish(true);
    }, 1000);
    $('pq-timer').textContent = fmt(secsLeft); $('pq-timer').classList.remove('low');
    show('pq-test'); renderQ();
    window.scrollTo({ top: $('pq-test').offsetTop - 20, behavior: 'smooth' });
  }
  function renderQ() {
    const q = test[at];
    $('pq-count').textContent = `Question ${at + 1} of ${test.length}`;
    $('pq-progress').style.width = `${(100 * at) / test.length}%`;
    $('pq-q').innerHTML = paras(q.q);
    $('pq-choices').innerHTML = q.choices.map((c, i) => `<li><button type="button" class="pq-choice" data-i="${i}" aria-pressed="false"><b>${L[i]}</b><span>${esc(c)}</span></button></li>`).join('');
    const next = $('pq-next') as HTMLButtonElement;
    next.disabled = true; next.textContent = at === test.length - 1 ? 'Finish test' : 'Next';
    $('pq-choices').querySelectorAll<HTMLButtonElement>('.pq-choice').forEach((b) => b.addEventListener('click', () => {
      picks[at] = Number(b.dataset.i);
      $('pq-choices').querySelectorAll('.pq-choice').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      next.disabled = false;
    }));
  }
  $('pq-next').addEventListener('click', () => {
    if (picks[at] === null) return;
    if (at < test.length - 1) { at++; renderQ(); window.scrollTo({ top: $('pq-test').offsetTop - 20, behavior: 'smooth' }); }
    else finish(false);
  });

  // ---- results ----
  function finish(timeUp: boolean) {
    clearInterval(tick);
    const right = test.reduce((n, q, i) => n + (picks[i] === q.answer ? 1 : 0), 0);
    const used = total - Math.max(0, secsLeft);
    store.seen = [...new Set([...store.seen, ...test.map((q) => q.id)])];
    store.history.push({ d: new Date().toISOString(), right, n: test.length, topic, secs: used });
    store.history = store.history.slice(-50);
    save(store);
    const pct = Math.round((100 * right) / test.length);
    $('pq-big').innerHTML = `${right} <small>/ ${test.length}</small>`;
    const msg = pct >= 80 ? 'Excellent work.' : pct >= 60 ? 'Solid. Read the explanations for the ones you missed.' : 'Every miss below is a lesson. Read the explanations, then try another 5.';
    $('pq-sub').textContent = `${timeUp ? "Time's up! " : ''}${pct}% in ${fmt(used)}. ${msg}`;
    $('pq-review').innerHTML = test.map((q, i) => {
      const p = picks[i], ok = p === q.answer, t = topics[q.topic];
      const list = q.choices.map((c, k) => `<li class="${k === q.answer ? 'is-right' : k === p ? 'is-wrong' : ''}"><b>${L[k]}</b><span>${esc(c)}</span>${k === p ? '<em>your answer</em>' : ''}</li>`).join('');
      return `<article class="pq-card pq-rev ${ok ? 'ok' : 'no'}">
        <div class="pq-rev-top"><span class="pq-mark">${ok ? '✓' : '✗'} Question ${i + 1}</span><span class="pq-tag" style="color:${t.color};background:${t.tint}">${esc(t.name)}</span></div>
        <div class="pq-q">${paras(q.q)}</div>
        <ol class="pq-rlist">${list}</ol>
        ${p === null ? '<p class="pq-skip">Not answered before time ran out.</p>' : ''}
        <details ${ok ? '' : 'open'}><summary>Explanation</summary><div class="pq-explain">${paras(q.explain)}<p class="pq-more"><a href="${q.link}">Review the notes for this topic →</a></p></div></details>
      </article>`;
    }).join('');
    show('pq-results');
    window.scrollTo({ top: $('pq-results').offsetTop - 20, behavior: 'smooth' });
  }
  $('pq-begin').addEventListener('click', begin);
  $('pq-again').addEventListener('click', begin);
  $('pq-home').addEventListener('click', () => { renderStart(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
  renderStart();
</script>

<style is:global>
  .pq-head { background: #fff; border-bottom: 1px solid var(--line); padding: 28px 0 22px; }
  .pq-head h1 { margin: 6px 0 8px; }
  .pq-head .crumbs { font-size: 14px; color: var(--muted); margin: 0; }
  .pq-head .lede { max-width: 64ch; color: var(--muted); margin: 0; }
  .pq-main { max-width: 820px; padding-top: 24px; padding-bottom: 60px; display: grid; gap: 18px; }
  .pq-card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 22px 24px; }
  .pq-card h2 { margin: 0 0 12px; font-size: 22px; }
  .pq-rules { margin: 0 0 18px; padding-left: 20px; line-height: 1.7; }
  .pq-label { display: block; font-weight: 700; font-size: 14px; margin-bottom: 6px; }
  .pq-select { width: 100%; max-width: 420px; min-height: 46px; border: 1px solid var(--line); border-radius: 12px; padding: 0 12px; font: inherit; font-size: 15px; background: #fff; }
  .pq-go { display: block; margin-top: 16px; min-height: 52px; padding: 0 28px; font-size: 17px; }
  .pq-seen { margin: 12px 0 0; color: var(--muted); font-size: 14px; }
  .pq-history { margin-top: 20px; border-top: 1px solid var(--line); padding-top: 16px; }
  .pq-history h3 { margin: 0 0 8px; font-size: 16px; }
  .pq-history ol { margin: 0; padding-left: 20px; line-height: 1.8; }
  .pq-history li span { color: var(--muted); font-size: 14px; margin-left: 6px; }
  .pq-best { margin: 8px 0 0; font-weight: 700; font-size: 14px; }
  .pq-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .pq-count { font-weight: 800; }
  .pq-timer { font-variant-numeric: tabular-nums; font-weight: 800; font-size: 18px; padding: 4px 12px; border-radius: 999px; background: #F1F5F9; }
  .pq-timer.low { background: #FEE2E2; color: #B91C1C; }
  .pq-progress { height: 6px; background: #EEF0EC; border-radius: 99px; overflow: hidden; margin-bottom: 16px; }
  .pq-progress span { display: block; height: 100%; background: #2F6B3F; transition: width .3s; }
  .pq-q p { margin: 0 0 10px; white-space: pre-line; line-height: 1.6; }
  .pq-choices { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 8px; }
  .pq-choice { width: 100%; display: flex; gap: 12px; align-items: flex-start; text-align: left; padding: 12px 14px; border: 1.5px solid var(--line); border-radius: 12px; background: #fff; font: inherit; font-size: 15.5px; line-height: 1.45; cursor: pointer; color: inherit; }
  .pq-choice:hover { border-color: #94A3B8; background: #F8FAFC; }
  .pq-choice b { flex: none; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: #F1F5F9; font-size: 13px; }
  .pq-choice[aria-pressed='true'] { border-color: #1D4ED8; background: #EFF6FF; }
  .pq-choice[aria-pressed='true'] b { background: #1D4ED8; color: #fff; }
  .pq-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
  .pq-actions .btn { min-height: 48px; padding: 0 24px; font-size: 16px; }
  .pq-actions .btn[disabled] { opacity: .45; cursor: default; }
  .pq-score { text-align: center; }
  .pq-score .pq-actions { justify-content: center; }
  .pq-big { font-size: 56px; font-weight: 800; margin: 0; line-height: 1.1; }
  .pq-big small { font-size: 28px; color: var(--muted); }
  .pq-sub { margin: 8px auto 0; max-width: 46ch; color: var(--muted); }
  .pq-review-h { margin: 10px 0 0; font-size: 20px; }
  #pq-review { display: grid; gap: 14px; }
  .pq-rev-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 10px; }
  .pq-mark { font-weight: 800; }
  .pq-rev.ok .pq-mark { color: #15803D; } .pq-rev.no .pq-mark { color: #B91C1C; }
  .pq-tag { font-size: 12.5px; font-weight: 700; padding: 4px 10px; border-radius: 999px; }
  .pq-rlist { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 6px; }
  .pq-rlist li { display: flex; gap: 10px; align-items: flex-start; padding: 9px 12px; border: 1.5px solid var(--line); border-radius: 10px; font-size: 15px; line-height: 1.4; }
  .pq-rlist li b { flex: none; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: #F1F5F9; font-size: 12.5px; }
  .pq-rlist li em { margin-left: auto; font-style: normal; font-size: 12.5px; font-weight: 700; color: var(--muted); white-space: nowrap; }
  .pq-rlist li.is-right { border-color: #16A34A; background: #F0FDF4; } .pq-rlist li.is-right b { background: #16A34A; color: #fff; }
  .pq-rlist li.is-wrong { border-color: #DC2626; background: #FEF2F2; } .pq-rlist li.is-wrong b { background: #DC2626; color: #fff; }
  .pq-skip { color: #B91C1C; font-weight: 700; margin: 8px 0 0; }
  .pq-rev details { margin-top: 12px; }
  .pq-rev summary { cursor: pointer; font-weight: 700; color: #2F6B3F; }
  .pq-explain { margin-top: 10px; padding: 14px 16px; background: #FFFDF4; border: 1px dashed #E5DCC3; border-radius: 12px; }
  .pq-explain p { margin: 0 0 10px; white-space: pre-line; line-height: 1.6; }
  .pq-more { margin: 4px 0 0 !important; font-weight: 700; }
  @media (max-width: 600px) { .pq-card { padding: 16px; } .pq-choice { font-size: 15px; } .pq-big { font-size: 46px; } }
</style>
